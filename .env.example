# Copy this file to ".env" and put your own MySQL details.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ngo_donation_db

# Any long random text. Keeps login sessions safe.
SECRET_KEY=change-this-to-a-long-random-text

# ---- Email (optional) ----
# Leave SMTP_HOST empty and update emails are saved as .eml files in the "outbox" folder
# (the app still works). To send real emails, fill these in. Gmail example:
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your 16-letter Google "App password"   SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Address used in the links inside emails
BASE_URL=http://127.0.0.1:5000
